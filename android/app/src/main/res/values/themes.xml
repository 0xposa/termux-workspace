<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TermuxWorkspace" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/background_terminal</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="alertDialogTheme">@style/Theme.TermuxWorkspace.Dialog</item>
        <item name="colorAccent">@color/accent_green</item>
    </style>

    <style name="Theme.TermuxWorkspace.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorAccent">@color/accent_green</item>
        <item name="android:background">@color/background_bar</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_primary</item>
    </style>
</resources>
